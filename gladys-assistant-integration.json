{
  "manifest_version": 1,
  "type": "device",
  "name": "MiLight",
  "description": {
    "en": "MiLight / LimitlessLED lamps through their Wi-Fi bridge, on the local network.",
    "fr": "Lampes MiLight / LimitlessLED par leur pont Wi-Fi, sur le réseau local."
  },
  "version": "0.1.0",
  "docker_image": "ghcr.io/lm1lc3n7/gladys-milight:0.1.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/LM1LC3N7/gladys-milight/main/cover.png",
  "categories": ["lighting"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer"
      },
      "description": {
        "en": "Give the IP address of the MiLight Wi-Fi bridge (fixed in your router) and tick the zones of your lamps (the groups 1 to 4 of the remote). MiLight lamps never report their state: Gladys shows the last command sent.",
        "fr": "Indiquez l’adresse IP du pont Wi-Fi MiLight (fixée dans votre box) et cochez les zones de vos lampes (les groupes 1 à 4 de la télécommande). Les lampes MiLight ne donnent jamais leur état : Gladys affiche la dernière commande envoyée."
      },
      "links": [
        {
          "url": "https://github.com/LM1LC3N7/gladys-milight/blob/main/docs/en.md",
          "label": {
            "en": "Documentation",
            "fr": "Documentation"
          }
        }
      ]
    },
    {
      "key": "bridge_address",
      "type": "string",
      "label": {
        "en": "Bridge IP address",
        "fr": "Adresse IP du pont"
      },
      "description": {
        "en": "IPv4 address of the bridge on the local network, with an optional port (5987 for a v6 bridge, 8899 for a legacy one by default).",
        "fr": "Adresse IPv4 du pont sur le réseau local, port facultatif (5987 pour un pont v6, 8899 pour un ancien par défaut)."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.50",
        "fr": "ex. 192.168.1.50"
      },
      "required": true
    },
    {
      "key": "bridge_version",
      "type": "select",
      "label": {
        "en": "Bridge model",
        "fr": "Modèle du pont"
      },
      "description": {
        "en": "v6: iBox 1 (with a lamp), iBox 2 and the bridges sold since 2016. Legacy: Wi-Fi bridges v3 to v5.",
        "fr": "v6 : iBox 1 (avec lampe), iBox 2 et les ponts vendus depuis 2016. Ancien : ponts Wi-Fi v3 à v5."
      },
      "required": false,
      "default": "v6",
      "options": [
        {
          "value": "v6",
          "label": {
            "en": "v6 (iBox 1, iBox 2)",
            "fr": "v6 (iBox 1, iBox 2)"
          }
        },
        {
          "value": "legacy",
          "label": {
            "en": "Legacy (v3 to v5)",
            "fr": "Ancien (v3 à v5)"
          }
        }
      ]
    },
    {
      "key": "full_color_zones",
      "type": "multi_select",
      "label": {
        "en": "RGB+CCT zones",
        "fr": "Zones RGB+CCT"
      },
      "description": {
        "en": "Zones of the colour and tunable white lamps (RGB+CCT, also sold as RGBWW). v6 bridge only.",
        "fr": "Zones des lampes couleur et blanc réglable (RGB+CCT, aussi vendues RGBWW). Pont v6 seulement."
      },
      "required": false,
      "default": [],
      "options": [
        {
          "value": "1",
          "label": {
            "en": "Zone 1",
            "fr": "Zone 1"
          }
        },
        {
          "value": "2",
          "label": {
            "en": "Zone 2",
            "fr": "Zone 2"
          }
        },
        {
          "value": "3",
          "label": {
            "en": "Zone 3",
            "fr": "Zone 3"
          }
        },
        {
          "value": "4",
          "label": {
            "en": "Zone 4",
            "fr": "Zone 4"
          }
        }
      ]
    },
    {
      "key": "rgbw_zones",
      "type": "multi_select",
      "label": {
        "en": "RGBW zones",
        "fr": "Zones RGBW"
      },
      "description": {
        "en": "Zones of the colour lamps with a single white (RGBW).",
        "fr": "Zones des lampes couleur à blanc unique (RGBW)."
      },
      "required": false,
      "default": [],
      "options": [
        {
          "value": "1",
          "label": {
            "en": "Zone 1",
            "fr": "Zone 1"
          }
        },
        {
          "value": "2",
          "label": {
            "en": "Zone 2",
            "fr": "Zone 2"
          }
        },
        {
          "value": "3",
          "label": {
            "en": "Zone 3",
            "fr": "Zone 3"
          }
        },
        {
          "value": "4",
          "label": {
            "en": "Zone 4",
            "fr": "Zone 4"
          }
        }
      ]
    },
    {
      "key": "white_zones",
      "type": "multi_select",
      "label": {
        "en": "Dual white zones",
        "fr": "Zones blanc double"
      },
      "description": {
        "en": "Zones of the dual white lamps (CCT): on and off only, their brightness has no level.",
        "fr": "Zones des lampes blanc double (CCT) : allumer et éteindre seulement, leur luminosité n’a pas de niveau."
      },
      "required": false,
      "default": [],
      "options": [
        {
          "value": "1",
          "label": {
            "en": "Zone 1",
            "fr": "Zone 1"
          }
        },
        {
          "value": "2",
          "label": {
            "en": "Zone 2",
            "fr": "Zone 2"
          }
        },
        {
          "value": "3",
          "label": {
            "en": "Zone 3",
            "fr": "Zone 3"
          }
        },
        {
          "value": "4",
          "label": {
            "en": "Zone 4",
            "fr": "Zone 4"
          }
        }
      ]
    },
    {
      "key": "bridge_lamp",
      "type": "boolean",
      "label": {
        "en": "Lamp of the iBox 1 bridge",
        "fr": "Lampe du pont iBox 1"
      },
      "description": {
        "en": "Creates the lamp built into the iBox 1 bridge. v6 bridge only.",
        "fr": "Crée la lampe intégrée au pont iBox 1. Pont v6 seulement."
      },
      "required": false,
      "default": false
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the device names",
        "fr": "Langue des noms d’appareils"
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français"
          }
        },
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_bridge",
      "label": {
        "en": "Test the bridge",
        "fr": "Tester le pont"
      },
      "timeout_seconds": 10
    }
  ]
}
